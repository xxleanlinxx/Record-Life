{
  "name": "record-life-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc -b",
    "test:device": "playwright test -c playwright.device.config.ts",
    "test:streamlit": "playwright test -c playwright.streamlit.config.ts",
    "benchmark:device": "RECORD_LIFE_BENCHMARK=1 playwright test -c playwright.device.config.ts --grep '大量資料基準'"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
