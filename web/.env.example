# Default: personal device storage. No API or secret is needed, including Vercel.
VITE_STORAGE_MODE=device

# Optional legacy server mode (requires a running persistent DuckDB API):
# VITE_STORAGE_MODE=server
# VITE_API_URL=https://your-api.example.com
# Never put RECORD_LIFE_API_TOKEN or other secrets in a VITE_* variable.
